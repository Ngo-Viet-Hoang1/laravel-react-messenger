# Auto-detect text files and normalize line endings on commit
* text=auto

# Source code files
*.cs text diff=csharp
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.html text
*.md text

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
