server {
    listen 443 ssl;
    server_name ${NGINX_SERVER_NAME};
    root /var/www/public;
    index index.php;
    charset utf-8;
    client_max_body_size 40M;

    # ─── SSL certificates ─────────────────────────────────────────────────────
    # ${NGINX_CERT_DOMAIN} được envsubst thay thế khi container khởi động.
    # PHẢI đặt trực tiếp ở đây — không đặt trong snippet vì snippet không qua envsubst.
    ssl_certificate     /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    limit_conn perip 20;

    # ─── WebSocket (Reverb) ───────────────────────────────────────────────────
    location /app/ {
        set $reverb_upstream http://reverb:8080;
        proxy_pass         $reverb_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /apps/ {
        set $reverb_upstream http://reverb:8080;
        proxy_pass       $reverb_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ─── Auth routes (rate limited) ───────────────────────────────────────────
    location ~ ^/(login|register|password|forgot-password) {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        try_files $uri $uri/ /index.php?$query_string;
        location ~ \.php$ { include /etc/nginx/snippets/php-fpm.conf; }
    }

    # ─── API routes (rate limited) ────────────────────────────────────────────
    location /api/ {
        limit_req zone=api burst=30 nodelay;
        limit_req_status 429;
        try_files $uri $uri/ /index.php?$query_string;
        location ~ \.php$ { include /etc/nginx/snippets/php-fpm.conf; }
    }

    # ─── User-uploaded storage ────────────────────────────────────────────────
    location ^~ /storage/ {
        alias /var/www/storage/app/public/;
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
        access_log off;
    }

    # ─── Static assets (long cache) ───────────────────────────────────────────
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
        access_log off;
    }

    # ─── General PHP routes ───────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ \.php$ {
        include /etc/nginx/snippets/php-fpm.conf;
    }

    location ~ /\.(?!well-known).* { deny all; }
    error_page 404 /index.php;
}
